[Unit]
Description=Azami sandbox daemon
Documentation=https://github.com/arjunkshah12345-hash/azami
After=network-online.target
Wants=network-online.target

[Service]
# Optional: AZAMI_API_KEY=..., AZAMI_LISTEN=0.0.0.0:7171 (only behind TLS + an API key)
EnvironmentFile=-/etc/azami/env
ExecStartPre=/usr/local/lib/azami/setup-host.sh
ExecStart=/usr/local/bin/azamid serve
Restart=on-failure
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
