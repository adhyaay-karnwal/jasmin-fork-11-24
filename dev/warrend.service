[Unit]
Description=Warren sandbox daemon
Documentation=https://github.com/arjunkshah12345-hash/warren
After=network-online.target
Wants=network-online.target

[Service]
# Optional: WARREN_API_KEY=..., WARREN_LISTEN=0.0.0.0:7171 (only behind TLS + an API key)
EnvironmentFile=-/etc/warren/env
ExecStartPre=/usr/local/lib/warren/setup-host.sh
ExecStart=/usr/local/bin/warrend serve
Restart=on-failure
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
